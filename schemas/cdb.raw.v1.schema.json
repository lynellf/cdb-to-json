{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdb.raw/1",
  "title": "CDB Raw Profile",
  "description": "Lossless extraction of CDB database tables as raw JSON.",
  "type": "object",
  "required": ["schema", "integerEncoding", "source", "tables", "extraTables"],
  "properties": {
    "schema": {
      "const": "cdb.raw/1",
      "description": "Schema identifier"
    },
    "integerEncoding": {
      "const": "signed-int64-decimal",
      "description": "Encoding scheme for integer values"
    },
    "source": {
      "type": "object",
      "required": ["fileName", "sha256", "sizeBytes", "converter"],
      "properties": {
        "fileName": { "type": "string" },
        "sha256": {
          "type": "string",
          "description": "Verified physical snapshot bundle SHA-256 hash prefixed with 'sha256:'",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "converter": { "const": "cdb-to-json/2.0.0" }
      }
    },
    "tables": {
      "type": "object",
      "required": ["datas", "texts"],
      "properties": {
        "datas": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "datas.id is required and non-null; all other INTEGER fields may be null per the accepted NULL-preserving raw contract.",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^-?[0-9]+$",
                "description": "Non-null INTEGER card ID as signed-int64 decimal string"
              },
              "ot": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Availability/OT flag; null preserves NULL SQLite INTEGER"
              },
              "alias": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Alias card ID; null preserves NULL SQLite INTEGER"
              },
              "setcode": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Setcode; null preserves NULL SQLite INTEGER"
              },
              "type": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Card type flags; null preserves NULL SQLite INTEGER"
              },
              "atk": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Attack points; null preserves NULL SQLite INTEGER"
              },
              "def": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Defense points; null preserves NULL SQLite INTEGER"
              },
              "level": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Level/rank/link markers; null preserves NULL SQLite INTEGER"
              },
              "race": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Monster race; null preserves NULL SQLite INTEGER"
              },
              "attribute": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Attribute; null preserves NULL SQLite INTEGER"
              },
              "category": {
                "type": ["string", "null"],
                "pattern": "^-?[0-9]+$",
                "description": "Category flags; null preserves NULL SQLite INTEGER"
              }
            },
            "additionalProperties": false
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^-?[0-9]+$",
                "description": "Non-null INTEGER card ID as signed-int64 decimal string"
              },
              "name": { "type": ["string", "null"] },
              "desc": { "type": ["string", "null"] },
              "str1": { "type": ["string", "null"] },
              "str2": { "type": ["string", "null"] },
              "str3": { "type": ["string", "null"] },
              "str4": { "type": ["string", "null"] },
              "str5": { "type": ["string", "null"] },
              "str6": { "type": ["string", "null"] },
              "str7": { "type": ["string", "null"] },
              "str8": { "type": ["string", "null"] },
              "str9": { "type": ["string", "null"] },
              "str10": { "type": ["string", "null"] },
              "str11": { "type": ["string", "null"] },
              "str12": { "type": ["string", "null"] },
              "str13": { "type": ["string", "null"] },
              "str14": { "type": ["string", "null"] },
              "str15": { "type": ["string", "null"] },
              "str16": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "extraTables": {
      "type": "array",
      "description": "Metadata for non-card tables (table name, columns, row count). Not a data dump.",
      "items": {
        "type": "object",
        "required": ["name", "columns", "rowCount"],
        "properties": {
          "name": { "type": "string" },
          "columns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rowCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
